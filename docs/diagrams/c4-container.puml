@startuml VitaBalance_C4_Container
title VitaBalance — C4 Level 2: Container Diagram

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 11
skinparam rectangleBorderColor #888888
skinparam rectangleBackgroundColor #FAFAFA
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #F5F5F5

top to bottom direction

' ===== PERSON =====
rectangle "  <b>Utilizator</b>\n<size:10>[Persoană]</size>\n\nUtilizator final\nal aplicaţiei web." as USER #DDE8F0

' ===== SYSTEM BOUNDARY =====
package "VitaBalance (System Boundary)" as SYS #F1F8E9 {

  rectangle "  <b>SPA — Frontend</b>\n<size:10>[Container: React 18, TypeScript, Vite, Tailwind CSS]</size>\n\nPagini: autentificare (email + parolǎ), profil medical,\nintroducere analize, recomandǎri,\nfeedback şi export PDF." as SPA #C8E6C9

  rectangle "  <b>Backend — API</b>\n<size:10>[Container: Python, FastAPI, Uvicorn]</size>\n\nExpune REST sub /api; login şi sesiune\nprin Supabase Auth; calcule deficite;\nmotor de reguli; persistǎ rezultate." as API #C8E6C9

}

' ===== EXTERNAL =====
rectangle "  <b>Supabase</b>\n<size:10>[Sistem Extern]</size>\n\nSupabase Auth: auth.users\n(email + parolǎ, sesiuni).\nPostgreSQL: users (profil), foods,\nlab_results, recommendations,\nfeedback." as SUPA #E3E3E3

USER -down-> SPA : "<b>Foloseşte</b>\n[HTTPS]"
SPA -down-> API : "<b>Apelează API</b>\n[HTTPS, JSON,\nAuthorization: Bearer]"
API -down-> SUPA : "<b>Login / sesiune + acces date</b>\n[Supabase Auth /auth/v1,\nSDK Supabase, operaţii CRUD]"

note bottom
  **Legendă**
  Verde = containere interne
  Gri   = sisteme / platforme externe
end note

@enduml
